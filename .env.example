# ==============================================================================
# SchoolRecon — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or export these variables in your shell environment.
# NEVER commit real passwords, production secrets, or tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Microsoft SQL Server 2022 Persistence Configuration
# ------------------------------------------------------------------------------
# Target host running Microsoft SQL Server (e.g. localhost, db.internal, or docker host)
SQLSERVER_HOST=localhost

# SQL Server listening port (default standard is 1433)
SQLSERVER_PORT=1433

# Application database catalog name
SQLSERVER_DATABASE=SchoolRecon

# Database authentication user
SQLSERVER_USER=schoolrecon_app

# Database authentication password (set externally; NEVER commit actual passwords)
SQLSERVER_PASSWORD=<SET_EXTERNALLY>

# Encryption and Certificate validation (default for dev/docker is Encrypt=false, TrustServerCertificate=true)
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# 2. ASP.NET Core API Configuration Mapping
# ------------------------------------------------------------------------------
# The ASP.NET Core backend (SchoolRecon.Api) dynamically synthesizes its connection
# string from the SQLSERVER_* environment variables using SqlConnectionStringBuilder:
#
#   Server={SQLSERVER_HOST},{SQLSERVER_PORT};
#   Database={SQLSERVER_DATABASE};
#   User Id={SQLSERVER_USER};
#   Password={SQLSERVER_PASSWORD};
#   Encrypt={SQLSERVER_ENCRYPT};
#   TrustServerCertificate={SQLSERVER_TRUST_SERVER_CERTIFICATE};
#   MultipleActiveResultSets=true;
#
# Alternatively, ASP.NET Core supports standard configuration key overrides:
#   ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=SchoolRecon;User Id=sa;Password=<SET_EXTERNALLY>;TrustServerCertificate=True;MultipleActiveResultSets=true;"
#
# API Listening Port
ASPNETCORE_URLS=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# 3. Vendor Collection Agent Integration
# ------------------------------------------------------------------------------
# Base URL for the persistent ASP.NET Core backend
API_BASE_URL=http://localhost:5000

# Base URL for the vendor portal crawler target
DEMO_VENDOR_PORTAL_URL=http://localhost:8085
